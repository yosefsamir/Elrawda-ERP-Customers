{
  "name": "whatsapp-erp",
  "version": "1.0.8",
  "private": true,
  "description": "Local multi-company customer operations and WhatsApp onboarding",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "whatsapp:test": "node scripts/whatsapp-test/server.cjs",
    "test": "node --test scripts/whatsapp-test/*.test.cjs",
    "dev": "tsx watch apps/server/index.ts",
    "dev:web": "vite",
    "dev:portal": "vite --config vite.portal.config.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/runtime/apps/server/index.js",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx --test tests/*.test.ts",
    "test:gemini": "tsx --test tests/gemini-worker-bridge.test.ts tests/image-processing.test.ts tests/installer-structure.test.ts tests/lock.test.ts tests/supervisor.test.ts",
    "release": "node scripts/release.mjs",
    "package:windows": "node scripts/release.mjs --bundle-runtime",
    "build:installer": "powershell.exe -ExecutionPolicy Bypass -File installer/build-installer.ps1",
    "admin": "node dist/runtime/scripts/maintenance/admin.js",
    "reset:company": "node dist/runtime/scripts/maintenance/admin.js reset-company",
    "reset:all": "node dist/runtime/scripts/maintenance/admin.js reset-all",
    "test:release": "node tests/release-smoke.mjs",
    "test:gemini:worker": "node tests/gemini-worker-smoke.mjs",
    "test:portal:processing": "tsx --test --test-name-pattern=\"photo portal reports\" tests/product-portal.test.ts && node tests/portal-processing-smoke.mjs",
    "test:whatsapp:browser": "node --test tests/whatsapp-browser-smoke.mjs",
    "gemini:login": "tsx apps/server/image-processing/cli.ts login",
    "gemini:verify": "tsx apps/server/image-processing/cli.ts verify",
    "gemini:status": "tsx apps/server/image-processing/cli.ts status"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "1.65.0",
    "mssql": "12.7.13",
    "playwright": "^1.65.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "whatsapp-web.js": "1.34.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "25.16.0"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
