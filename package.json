{
  "name": "whatsapp-erp",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Local multi-company customer operations and WhatsApp onboarding",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "whatsapp:test": "node scripts/whatsapp-test/server.cjs",
    "test": "node --test scripts/whatsapp-test/*.test.cjs",
    "dev": "tsx watch apps/server/index.ts",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "start": "node dist/runtime/apps/server/index.js",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx --test tests/*.test.ts",
    "release": "node scripts/release.mjs",
    "admin": "node dist/runtime/scripts/maintenance/admin.js",
    "test:release": "node tests/release-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "lucide-react": "1.65.0",
    "mssql": "12.7.13",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "whatsapp-web.js": "1.34.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "25.16.0"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
